# Build-time: where to read published content from (the site still builds from the snapshot if unreachable)
PAYLOAD_URL=http://localhost:3000
TENANT_SLUG=fuel-mechanical
SITE_URL=https://fuelmechanical.asandov.com

# Baked into the page: where the contact form posts, and the Turnstile widget key.
# 1x00000000000000000000AA is Cloudflare's always-pass test sitekey; use the real one in Pages.
PUBLIC_PAYLOAD_URL=http://localhost:3000
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
