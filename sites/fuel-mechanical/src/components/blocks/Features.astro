---
import type { Block } from '../../lib/cms'

type Props = { block: Extract<Block, { blockType: 'features' }> }
const { block } = Astro.props
---

<section class="section">
  <div class="section-container">
    <div class="card features-block">
      {block.heading && <h2 class="section-title">{block.heading}</h2>}
      <div class="features-grid">
        {
          (block.items ?? []).map((f) => (
            <div class="feature">
              <h3>{f.title}</h3>
              {f.text && <p>{f.text}</p>}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .features-block {
    padding: 2rem;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .feature {
    text-align: center;
    padding: 1.5rem;
    border: 2px solid #e5e7eb;
    border-radius: 8px;
    transition: all 0.3s ease;
  }

  .feature:hover {
    border-color: var(--primary-blue);
    transform: translateY(-4px);
    box-shadow: 0 8px 25px rgba(59, 130, 246, 0.15);
  }

  h3 {
    color: var(--text-dark);
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
    font-weight: 600;
  }

  p {
    color: var(--text-light);
    margin: 0;
  }

  @media (max-width: 768px) {
    .features-block {
      padding: 1.5rem;
    }

    .features-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
