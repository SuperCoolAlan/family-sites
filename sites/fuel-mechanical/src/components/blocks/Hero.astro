---
import { getContent, type Block } from '../../lib/cms'
import { safeHref, isExternal } from '../../lib/links'
import { mediaURL } from '../../lib/media'

type Props = { block: Extract<Block, { blockType: 'hero' }> }
const { block } = Astro.props
const { settings } = await getContent()
const full = block.size === 'full'
const bg = mediaURL(block.backgroundImage, 'hero')
const logo = mediaURL(settings.logo, 'card') ?? '/logo-full-color.png'
---

<section
  class:list={['hero', full ? 'hero-full' : 'hero-compact']}
  style={bg ? `background-image: linear-gradient(135deg, rgba(59,130,246,.85), rgba(29,78,216,.9)), url('${bg}')` : undefined}
>
  <div class="hero-content">
    {block.showLogo && <img src={logo} alt={settings.businessName} class="hero-logo" />}
    <h1 class="oswald-brand">{block.heading}</h1>
    {block.tagline && <p class="tagline">{block.tagline}</p>}
    {block.subheading && <p class="description">{block.subheading}</p>}
    {
      block.buttons && block.buttons.length > 0 && (
        <div class="cta-buttons">
          {block.buttons.map((b) => (
            <a
              href={safeHref(b.href)}
              class:list={['btn', b.style === 'secondary' ? 'btn-secondary' : 'btn-primary']}
              {...(isExternal(b.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              {b.label}
            </a>
          ))}
        </div>
      )
    }
  </div>
</section>

<style>
  .hero {
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--primary-blue) 0%, var(--secondary-blue) 100%);
    background-size: cover;
    background-position: center;
    color: white;
    text-align: center;
    padding: 4rem 2rem;
  }

  .hero-full {
    min-height: calc(100vh - 80px);
  }

  .hero-content {
    max-width: 800px;
  }

  .hero-logo {
    width: 200px;
    height: auto;
    margin-bottom: 2rem;
  }

  h1 {
    font-size: 3rem;
    margin: 1rem 0;
  }

  .tagline {
    font-size: 1.5rem;
    margin: 1rem 0;
    color: #fbbf24;
  }

  .hero-compact .description {
    font-size: 1.25rem;
    margin: 0;
  }

  .description {
    font-size: 1.25rem;
    margin: 2rem 0;
    opacity: 0.9;
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  @media (max-width: 768px) {
    h1 {
      font-size: 2rem;
    }

    .cta-buttons {
      flex-direction: column;
      align-items: center;
    }

    .cta-buttons .btn {
      width: 200px;
      text-align: center;
    }
  }
</style>
