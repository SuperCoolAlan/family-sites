---
import { getContent, isObj, type Block, type Media, type Project } from '../../lib/cms'
import { mediaURL, srcset } from '../../lib/media'
import ProjectCard from '../ProjectCard.astro'

type Props = { block: Extract<Block, { blockType: 'gallery' }> }
const { block } = Astro.props
const { projects } = await getContent()
const picked = (block.projects ?? []).filter(isObj<Project>)
const shownProjects = picked.length ? picked : projects
const images = (block.images ?? []).filter((i) => isObj<Media>(i.image))
---

<section class="section alt">
  <div class="section-container">
    {block.heading && <h2 class="section-title text-center">{block.heading}</h2>}
    {block.intro && <p class="section-intro">{block.intro}</p>}
    {
      block.source === 'images' ? (
        <div class="photo-grid">
          {images.map((i) => (
            <figure class="card photo">
              <img src={mediaURL(i.image, 'card')} srcset={srcset(i.image)} sizes="(max-width: 768px) 100vw, 400px" alt={(i.image as Media).alt} loading="lazy" />
              {i.caption && <figcaption>{i.caption}</figcaption>}
            </figure>
          ))}
        </div>
      ) : (
        <div class="projects-grid">
          {shownProjects.map((p) => <ProjectCard project={p} />)}
        </div>
      )
    }
  </div>
</section>

<style>
  .projects-grid,
  .photo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .photo {
    overflow: hidden;
    margin: 0;
  }

  .photo img {
    width: 100%;
    height: 240px;
    object-fit: cover;
    display: block;
  }

  figcaption {
    padding: 0.75rem 1rem;
    color: var(--text-light);
  }

  @media (max-width: 768px) {
    .projects-grid,
    .photo-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
