---
// Simple stroke icons keyed by the CMS Services `icon` select values.
interface Props {
  name?: string | null
  size?: number
}
const { name = 'hvac', size = 40 } = Astro.props

const paths: Record<string, string> = {
  cooling: 'M12 2v20M4.9 6l14.2 12M19.1 6 4.9 18M9 4l3 2 3-2M9 20l3-2 3 2',
  heating: 'M12 22c4 0 7-3 7-7 0-5-4-7-5-11-2 3-3 5-3 7-1-1-2-2-2-4-2 2-4 5-4 8 0 4 3 7 7 7z',
  air: 'M3 8h11a3 3 0 1 0-3-3M3 12h16a3 3 0 1 1-3 3M3 16h8',
  wrench: 'M14.7 6.3a4 4 0 0 0 5 5L21 13l-8 8-3-3 8-8-1.3-1.3a4 4 0 0 1-5-5L13 2l2 2-2 2 2 2 2-2 2 2',
  industrial: 'M2 21V9l6 4V9l6 4V5h4l2 16H2zM6 17h2M11 17h2M16 17h2',
  commercial: 'M4 21V3h10v18M14 9h6v12M7 7h2M7 11h2M7 15h2M17 13h1M17 17h1M2 21h20',
  water: 'M12 2s7 7.5 7 13a7 7 0 0 1-14 0c0-5.5 7-13 7-13z',
  emergency: 'M12 3 2 21h20L12 3zM12 10v5M12 18h.01',
  hvac: 'M12 12m-9 0a9 9 0 1 0 18 0 9 9 0 1 0-18 0M12 12l0-6a3 3 0 0 1 3 3zM12 12l5 3a3 3 0 0 1-4 1zM12 12l-5 3a3 3 0 0 1 0-4z',
}
const d = paths[name ?? 'hvac'] ?? paths.hvac
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={d}></path>
</svg>
