---
// Shown until PUBLIC_CONSTRUCTION_BANNER=off is set in the Pages project; it's read at build time.
const show = import.meta.env.PUBLIC_CONSTRUCTION_BANNER !== 'off'
---

{
  show && (
    <div class="construction" role="status">
      <span aria-hidden="true">🚧</span> This site is under construction. Some details are still being finalized, so call us to confirm anything you
      need.
    </div>
  )
}

<style>
  .construction {
    background: repeating-linear-gradient(-45deg, var(--accent-orange) 0 18px, #f59e0b 18px 36px);
    color: var(--text-dark);
    font-weight: 600;
    text-align: center;
    padding: 0.55rem 1rem;
    font-size: 0.95rem;
    line-height: 1.4;
  }
</style>
