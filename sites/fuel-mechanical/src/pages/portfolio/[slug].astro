---
import type { GetStaticPaths } from 'astro'

import Hero from '../../components/blocks/Hero.astro'
import Base from '../../layouts/Base.astro'
import { getContent, type Media, type Project } from '../../lib/cms'
import { mediaURL, srcset } from '../../lib/media'
import { richTextToHTML } from '../../lib/richtext'

export const getStaticPaths = (async () => {
  const { projects } = await getContent()
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }))
}) satisfies GetStaticPaths

const { project } = Astro.props as { project: Project }
const { settings } = await getContent()
const photos = [project.coverImage, ...(project.gallery ?? []).map((g) => g.image)].filter(
  (m, i, all): m is Media => typeof m === 'object' && m !== null && all.findIndex((x) => typeof x === 'object' && x?.id === m.id) === i,
)
const captions = new Map((project.gallery ?? []).map((g) => [typeof g.image === 'object' ? g.image.id : g.image, g.caption]))
const when = project.completedOn ? new Date(project.completedOn).toLocaleDateString('en-US', { month: 'long', year: 'numeric' }) : null
---

<Base title={`${project.title} - ${settings.businessName}`} description={project.summary} image={project.coverImage}>
  <Hero block={{ blockType: 'hero', heading: project.title, subheading: project.summary, size: 'compact' }} />
  <section class="section">
    <div class="section-container">
      <p class="meta">
        {[project.category, project.location, when].filter(Boolean).join(' · ')}
      </p>
      {project.description && <div class="card body rich-text" set:html={richTextToHTML(project.description)} />}
      {
        photos.length > 0 ? (
          <div class="photos">
            {photos.map((m) => (
              <figure class="card">
                <img src={mediaURL(m, 'card')} srcset={srcset(m)} sizes="(max-width: 768px) 100vw, 600px" alt={m.alt} loading="lazy" />
                {captions.get(m.id) && <figcaption>{captions.get(m.id)}</figcaption>}
              </figure>
            ))}
          </div>
        ) : (
          <p class="meta">Photos coming soon.</p>
        )
      }
      <p class="back"><a href="/portfolio">← Back to portfolio</a></p>
    </div>
  </section>
</Base>

<style>
  .meta {
    color: var(--text-light);
    text-align: center;
  }

  .body {
    padding: 2rem;
    margin: 2rem 0;
  }

  .photos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }

  figure {
    margin: 0;
    overflow: hidden;
  }

  figure img {
    width: 100%;
    display: block;
  }

  figcaption {
    padding: 0.75rem 1rem;
    color: var(--text-light);
  }

  .back {
    margin-top: 2rem;
    text-align: center;
  }

  .back a {
    color: var(--primary-blue);
  }
</style>
