---
import '../styles/global.css'
import ConstructionBanner from '../components/ConstructionBanner.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import { getContent } from '../lib/cms'
import { mediaURL } from '../lib/media'
import type { Media } from '../lib/cms'

interface Props {
  title?: string | null
  description?: string | null
  image?: Media | number | null
}

const { settings } = await getContent()
const title = Astro.props.title || `${settings.businessName} - ${settings.tagline ?? ''}`.replace(/ - $/, '')
const description = Astro.props.description || settings.description || ''
const ogImage = mediaURL(Astro.props.image, 'card') ?? mediaURL(settings.logo, 'card')
const canonical = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.png" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <script is:inline>
      // Runs before paint so a saved dark preference doesn't flash light first.
      try {
        const t = localStorage.getItem('theme')
        if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark')
        }
      } catch {}
    </script>
  </head>
  <body>
    <div class="app-container">
      <ConstructionBanner />
      <Nav />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<style>
  .app-container {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
  }
</style>
