---
import { pagePath, t, type Lang } from '../i18n'
import { getLocale } from '../lib/cms'
import { mediaURL } from '../lib/media'
import LangToggle from './LangToggle.astro'

type Props = { lang: Lang; slug?: string }
const { lang, slug } = Astro.props
const { settings, pages } = await getLocale(lang)
const links = pages
  .filter((p) => typeof p.navOrder === 'number')
  .sort((a, b) => (a.navOrder ?? 0) - (b.navOrder ?? 0))
  .map((p) => ({ label: p.title, href: pagePath(lang, p.slug), current: p.slug === slug }))
const logo = mediaURL(settings.logo, 'thumbnail') ?? '/logo.png'
---

<header class="site-header">
  <div class="wrap bar">
    <a href={pagePath(lang, 'home')} class="brand">
      <img src={logo} alt="" width="48" height="48" class="logo" />
      <span class="name">{settings.shortName || settings.businessName}</span>
    </a>
    <nav class="nav" aria-label={t(lang).mainNav}>
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={l.current ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <LangToggle lang={lang} slug={slug} />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgb(253 247 239 / 94%);
    backdrop-filter: saturate(1.4) blur(8px);
    border-bottom: 1px solid var(--line);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    column-gap: 1rem;
    padding-top: 0.6rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex: 1 1 0;
    min-width: 0;
    color: var(--cocoa);
    text-decoration: none;
  }

  .logo {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--apricot);
    flex-shrink: 0;
  }

  .name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1rem, 0.6rem + 1.6vw, 1.2rem);
    line-height: 1.1;
  }

  /* Phones: the menu drops to its own swipeable row under the brand. */
  .nav {
    order: 3;
    flex: 0 0 calc(100% + 2 * var(--gutter));
    min-width: 0;
    margin-inline: calc(var(--gutter) * -1);
  }

  .nav ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0.4rem var(--gutter) 0.5rem;
    overflow-x: auto;
    scrollbar-width: none;
    scroll-snap-type: x proximity;
  }

  .nav ul::-webkit-scrollbar {
    display: none;
  }

  .nav li {
    scroll-snap-align: start;
    flex-shrink: 0;
  }

  .nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.9rem;
    border-radius: 999px;
    color: var(--cocoa);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .nav a:hover {
    background: var(--blush);
    color: var(--berry-dark);
  }

  .nav a[aria-current='page'] {
    background: var(--blush);
    color: var(--berry-dark);
    box-shadow: inset 0 -2px 0 var(--berry);
  }

  @media (min-width: 900px) {
    .bar {
      flex-wrap: nowrap;
      padding-block: 0.75rem;
    }

    .brand {
      flex: 0 0 auto;
    }

    .nav {
      order: 0;
      flex: 1 1 auto;
      margin: 0;
    }

    .nav ul {
      justify-content: flex-end;
      padding: 0;
    }
  }
</style>
