---
import type { Block } from '../../lib/cms'

type Props = { block: Extract<Block, { blockType: 'faq' }> }
const { block } = Astro.props
---

<section class="section">
  <div class="wrap narrow">
    {block.heading && <h2>{block.heading}</h2>}
    {
      (block.items ?? []).map((i) => (
        <details class="card">
          <summary>{i.question}</summary>
          <p>{i.answer}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .narrow {
    max-width: 46rem;
  }

  details {
    margin-bottom: 0.75rem;
    padding: 0 1.25rem;
  }

  summary {
    cursor: pointer;
    padding: 1rem 0;
    font-weight: 700;
    min-height: 44px;
  }

  details p {
    color: var(--cocoa-soft);
  }
</style>
