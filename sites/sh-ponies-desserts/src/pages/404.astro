---
import { DEFAULT_LANG, LOCALES, pagePath, t } from '../i18n'
import Base from '../layouts/Base.astro'
---

<Base lang={DEFAULT_LANG} title={t(DEFAULT_LANG).notFoundTitle}>
  <section class="section">
    <div class="wrap notfound">
      {
        LOCALES.map((l) => (
          <div lang={l}>
            <h1>{t(l).notFoundTitle}</h1>
            <p>{t(l).notFoundText}</p>
            <a class="btn" href={pagePath(l, 'home')}>
              {t(l).goHome}
            </a>
          </div>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .notfound {
    display: grid;
    gap: 3rem;
    text-align: center;
  }

  h1 {
    font-size: clamp(2rem, 4vw + 1rem, 3rem);
  }
</style>
