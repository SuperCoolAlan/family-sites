# Local dev values match docker-compose.yml at the repo root. Copy to .env and adjust.
SERVER_URL=http://localhost:3000
DATABASE_URI=postgresql://payload:payload@localhost:5432/payload
PAYLOAD_SECRET=replace-with-openssl-rand-hex-32
CORS_ORIGINS=http://localhost:4321,http://localhost:4322

# SeaweedFS (docker-compose) stands in for Cloudflare R2 locally
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=cms-asandov-com
S3_REGION=auto
S3_ACCESS_KEY_ID=devaccesskey
S3_SECRET_ACCESS_KEY=devsecretkey
S3_FORCE_PATH_STYLE=true
MEDIA_PUBLIC_URL=http://localhost:9000/cms-asandov-com

# Authentik OIDC (leave OIDC_CLIENT_ID empty to hide the SSO button)
OIDC_ISSUER=https://auth.asandov.com/application/o/cms/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Cloudflare Turnstile secret; Cloudflare's documented always-pass test secret works locally
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# SMTP (optional; leave SMTP_HOST empty to log emails to the console instead)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Family Sites <no-reply@example.com>

# Seed-only: creates the break-glass super-admin if no users exist yet
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-locally
