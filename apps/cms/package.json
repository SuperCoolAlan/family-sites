    "@payloadcms/ui": "3.91.0",
    "cross-env": "10.1.0",
    "graphql": "^16.8.1",
    "next": "16.4.2",
    "payload": "3.91.0",
    "payload-oauth2": "1.0.21",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5"
